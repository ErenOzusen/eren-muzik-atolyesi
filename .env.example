# Frontend (Vite) environment variables.
# Copy this file to .env.local for local development — Vite loads .env.local
# automatically and it is already git-ignored (see .gitignore: *.local).
# Never commit real values; this file only documents the expected shape.

# Backend API base URL used by the frontend for every request (contact,
# appointments, admin login, videos, blocked slots, weekly schedule, etc.).
# Local development:
#   VITE_API_BASE_URL=http://localhost:5000
# Production (set this in Vercel's project environment variables):
#   VITE_API_BASE_URL=https://eren-muzik-atolyesi-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000
