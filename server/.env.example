# Backend environment variables.
# Copy this file to server/.env for local development. server/.env is
# git-ignored — never commit real secrets.
#
# Every variable marked (required) has no insecure default: the backend now
# fails to start (fail-closed) rather than run without it, in every
# environment, development included.

# --- Database -----------------------------------------------------------
# MongoDB Atlas (or any MongoDB) connection string. Without this the server
# still starts, but every DB-backed route returns 503 instead of writing.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# --- Admin auth (required) -----------------------------------------------
# Plain admin password checked at /api/admin/login. Pick something you would
# not reuse elsewhere; there is no username, only this one shared password.
ADMIN_PASSWORD=

# Random secret used to sign time-limited admin session tokens (HMAC-SHA256).
# Must be at least 32 characters with reasonable variety (the backend
# refuses to start otherwise — a short or low-variety value would make the
# signature forgeable). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value immediately invalidates every existing admin session.
ADMIN_TOKEN_SECRET=

# Optional: admin session lifetime in seconds. Defaults to 43200 (12 hours)
# if not set.
# ADMIN_TOKEN_TTL_SECONDS=43200

# --- Reverse proxy (required for correct rate limiting on Render) --------
# Controls Express's "trust proxy" setting, which determines how the real
# client IP is read from X-Forwarded-For — get this wrong and rate limiting
# either treats every visitor as one shared "IP" or becomes bypassable.
#   - Unset on Render (or when NODE_ENV=production): defaults to 1 (trust
#     exactly the one reverse-proxy hop Render's edge adds) — correct for
#     Render's actual topology, no action needed.
#   - Unset locally: defaults to false (no reverse proxy in front of a
#     local dev server) — correct for plain `npm start`, no action needed.
#   - Set explicitly only if deploying somewhere with a different proxy
#     topology (e.g. "2" for two hops, or "false"/"true" to force a value).
# TRUST_PROXY=1

# --- CORS -----------------------------------------------------------------
# Comma-separated list of ADDITIONAL frontend origins allowed to call this
# API in the browser. The production frontend origin
# (https://eren-muzik-atolyesi.vercel.app) and localhost dev origins are
# ALWAYS allowed regardless of this setting — configuring this can only add
# origins, never remove the production site's access. Malformed entries or
# a literal "*" wildcard make the backend refuse to start.
# ALLOWED_ORIGINS=https://staging-frontend.example.com

# --- Outbound email ---------------------------------------------------------
# Sender identity used both for the "from" address shown to recipients and
# as part of the Brevo API payload below. Required for any email to be sent
# (contact/appointment notifications, appointment confirmations); if unset,
# the backend just logs a warning and skips sending — it does not fail
# requests.
EMAIL_USER=

# Brevo (Sendinblue) transactional email API key. This project sends all
# outbound email through the Brevo HTTP API — nodemailer/SMTP and resend are
# not used and are not installed as dependencies.
BREVO_API_KEY=

# Where new contact-form/appointment notifications are sent when no
# recipient is otherwise specified.
NOTIFICATION_EMAIL=

# --- AI content-automation pipeline (see AI_ROUTER.md / PROJECT_STATE.md) --
# These are unrelated to the website/CRM above; they are consumed by the
# GitHub Actions AI Router (.github/scripts/ai_router.py), not by server.js.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=

# --- Server ---------------------------------------------------------------
# PORT=5000
