    },
    "hybrid": {
      "engine": "vibeframe",
      "engine_status": "compatibility_verified",
      "requires_raw_video": true,
      "allows_ai_broll": true,
      "next_stage": "raw-video-intake-gate"
    },
    "faceless": {
      "engine": "moneyprinterturbo",
      "engine_status": "compatibility_verified",
      "requires_raw_video": false,
      "allows_ai_broll": true,
      "next_stage": "moneyprinter-production-adapter"
    },
    "premium_ai": {
      "engine": "openreels",
      "engine_status": "research_only",
      "requires_raw_video": false,
      "allows_ai_broll": true,
      "next_stage": "openreels-adapter-not-enabled"
