{
  "schema_version": 1,
  "default_auto_mode": "human",
  "generation_dispatch_enabled": false,
  "premium_ai_manual_only": true,
  "modes": {
    "human": {
      "engine": "vibeframe",
      "engine_status": "compatibility_verified",
