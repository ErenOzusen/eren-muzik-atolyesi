      "muayene sürecini anlat",
      "kameraya anlat"
    ],
    "hybrid_support": [
      "b-roll",
      "ekranda göster",
      "grafik",
      "animasyon",
      "röntgen görseli",
      "şema",
      "görsel destek"
    ],
    "faceless_preferred": [
      "bilmeniz gereken",
      "ilginç bilgi",
      "nedir",
      "neden",
      "karşılaştırma",
      "liste",
      "5 bilgi",
      "3 neden"
