{
  "schema_version": 1,
  "routing": {
    "default_order": [
      "anthropic",
      "openai",
      "deepseek",
      "qwen"
    ],
    "timeout_seconds": 120,
    "models_by_output": {
      "weekly-report-raw.md": {
        "anthropic": {
          "model_env": "RESEARCH_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "RESEARCH_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "RESEARCH_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "RESEARCH_QWEN_MODEL"
        }
      },
      "scripts-raw.txt": {
        "anthropic": {
          "model_env": "SCRIPT_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "SCRIPT_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "SCRIPT_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "SCRIPT_QWEN_MODEL"
        }
      },
      "raw-report.md": {
        "anthropic": {
          "model_env": "QC_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "QC_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "QC_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "QC_QWEN_MODEL"
        }
      },
      "final-scripts.md": {
        "anthropic": {
          "model_env": "CORRECTION_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "CORRECTION_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "CORRECTION_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "CORRECTION_QWEN_MODEL"
        }
      },
      "final-check.md": {
        "anthropic": {
          "model_env": "FINAL_CHECK_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "FINAL_CHECK_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "FINAL_CHECK_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "FINAL_CHECK_QWEN_MODEL"
        }
      },
      "filming-package.md": {
        "anthropic": {
          "model_env": "FILMING_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "FILMING_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "FILMING_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "FILMING_QWEN_MODEL"
        }
      },
      "editing-package.md": {
        "anthropic": {
          "model_env": "EDITING_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "EDITING_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "EDITING_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "EDITING_QWEN_MODEL"
        }
      },
      "scene-plan.json": {
        "anthropic": {
          "model_env": "SCENE_PLAN_ANTHROPIC_MODEL"
        },
        "openai": {
          "model_env": "SCENE_PLAN_OPENAI_MODEL"
        },
        "deepseek": {
          "model_env": "SCENE_PLAN_DEEPSEEK_MODEL"
        },
        "qwen": {
          "model_env": "SCENE_PLAN_QWEN_MODEL"
        }
      }
    },
    "budget_config": ".github/config/real-ai-budget.json",
    "budget_config_by_output": {
      "filming-package.md": ".github/config/mvp-production-budget.json"
    },
    "retry_http_statuses": [
      408,
      409,
      429,
      500,
      502,
      503,
      504
    ],
    "quality_contracts_by_output": {
      "filming-package.md": ".github/config/contracts/filming-package.json"
    },
    "transformers_by_output": {
      "final-scripts.md": ".github/scripts/targeted_correction_transform.py",
      "final-check.md": ".github/scripts/final_technical_freshness_transform.py",
      "filming-package.md": ".github/scripts/filming_budget_guard_transform.py"
    },
    "max_tokens_by_output": {
      "filming-package.md": 1800
    },
    "provider_order_by_output": {
      "filming-package.md": [
        "anthropic"
      ]
    }
  },
  "providers": {
    "anthropic": {
      "api_style": "anthropic_messages",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "secret_env": "ANTHROPIC_API_KEY",
      "model_env": "ANTHROPIC_MODEL",
      "use_primary_model_as_default": true,
      "supports_web_search": true
    },
    "openai": {
      "api_style": "openai_chat",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "secret_env": "OPENAI_API_KEY",
      "model_env": "OPENAI_MODEL"
    },
    "deepseek": {
      "api_style": "openai_chat",
      "endpoint": "https://api.deepseek.com/chat/completions",
      "secret_env": "DEEPSEEK_API_KEY",
      "model_env": "DEEPSEEK_MODEL",
      "default_model": "deepseek-v4-pro"
    },
    "qwen": {
      "api_style": "openai_chat",
      "endpoint_env": "QWEN_CHAT_ENDPOINT",
      "default_endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions",
      "secret_env": "DASHSCOPE_API_KEY",
      "model_env": "QWEN_MODEL",
      "default_model": "qwen3.8-max"
    }
  }
}
